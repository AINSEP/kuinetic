/**
 * Replay-all FAB, shared by every demo/showcase/*.html page.
 *
 * A real `location.reload()` — effects that read live scroll/pointer state (parallax-y
 * timelines, hover-gated flips) don't have a clean "replay" concept without their real trigger,
 * so resetting+replaying them in place produced stuck or reversed-looking animations. A full
 * reload re-runs every entrance exactly as it played on first load, no special-casing needed.
 *
 * The one thing a bare reload gets wrong is scroll position — it jumps back to the top. So this
 * stashes the current scroll offset first; the inline head script on every page checks for it
 * on the next load and restores it (see index.html's second head <script>), making the reload
 * read as "replay the animations" rather than "go back to the top of the page."
 */
;(function () {
  // Material Design's "replay" glyph: a circular arrow with a rewind-style arrowhead.
  const REPLAY_ICON =
    '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">' +
    '<path fill="currentColor" d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8Z"/>' +
    '</svg>'

  function mountReplayButton() {
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'kui-replay-fab'
    button.setAttribute('aria-label', 'Replay every effect on this page')
    button.innerHTML = REPLAY_ICON
    button.addEventListener('click', function () {
      try { sessionStorage.setItem('kui-replay-scroll-y', String(window.scrollY)) } catch (e) {}
      window.location.reload()
    })
    document.body.appendChild(button)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountReplayButton)
  } else {
    mountReplayButton()
  }
})()
