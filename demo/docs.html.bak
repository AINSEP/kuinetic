<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>kUInetic — docs</title>
    <script>
      /* Resolve the theme synchronously, before any stylesheet paints — see theme.js for the
         toggle-button mounting logic that runs later, once dataset.theme is already correct. */
      ;(function () {
        var KEY = 'kuinetic-showcase-theme'
        var theme = null
        try {
          var stored = localStorage.getItem(KEY)
          if (stored === 'light' || stored === 'dark') theme = stored
        } catch (e) {}
        if (!theme) {
          try {
            theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
          } catch (e) {
            theme = 'dark'
          }
        }
        document.documentElement.dataset.theme = theme
      })()
    </script>
    <link rel="stylesheet" href="./kuinetic.css?v=1786402037" />
    <link rel="stylesheet" href="./style.css" />
    <script defer src="./nav.js"></script>
  </head>
  <body>
    <header class="site" data-nav-root>
      <strong>kUInetic</strong>
      <nav data-nav-panel data-kui="menu-stagger-open on:manual" hidden>
        <div class="kui-nav-dropdown" data-nav-group="docs">
          <button type="button" class="kui-nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            Docs
          </button>
          <div class="kui-nav-dropdown-menu" data-kui="dropdown-open on:manual" hidden>
            <a href="./docs.html?doc=catalog">Catalog</a>
            <a href="./docs.html?doc=design">Architecture</a>
          </div>
        </div>

        <div class="kui-nav-dropdown" data-nav-group="css-animations">
          <button
            type="button"
            class="kui-nav-dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            data-nav-pages="reveals.html,scroll.html,interactive.html,text.html,data-hover.html,ambient-feedback.html,nav-forms.html"
          >
            CSS Animations
          </button>
          <div class="kui-nav-dropdown-menu" data-kui="dropdown-open on:manual" hidden>
            <a href="./reveals.html" data-nav-link="reveals.html">Reveals</a>
            <a href="./scroll.html" data-nav-link="scroll.html">Scroll</a>
            <a href="./interactive.html" data-nav-link="interactive.html">Interactive</a>
            <a href="./text.html" data-nav-link="text.html">Text</a>
            <a href="./data-hover.html" data-nav-link="data-hover.html">Data &amp; Hover</a>
            <a href="./ambient-feedback.html" data-nav-link="ambient-feedback.html">Ambient &amp; Feedback</a>
            <a href="./nav-forms.html" data-nav-link="nav-forms.html">Nav &amp; Forms</a>
          </div>
        </div>

        <div class="kui-nav-dropdown" data-nav-group="js-animations">
          <button type="button" class="kui-nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            JS Animations
          </button>
          <div class="kui-nav-dropdown-menu" data-kui="dropdown-open on:manual" hidden>
            <span class="kui-nav-coming-soon">Coming soon</span>
          </div>
        </div>

        <div class="kui-nav-dropdown" data-nav-group="designs">
          <button
            type="button"
            class="kui-nav-dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            data-nav-pages="index.html,landing-minimal.html,landing-studio.html"
          >
            Designs
          </button>
          <div class="kui-nav-dropdown-menu" data-kui="dropdown-open on:manual" hidden>
            <a href="./index.html" data-nav-link="index.html">Hero SaaS</a>
            <a href="./landing-minimal.html" data-nav-link="landing-minimal.html">Minimal Studio</a>
            <a href="./landing-studio.html" data-nav-link="landing-studio.html">Motion Playground</a>
          </div>
        </div>
      </nav>
      <button
        type="button"
        class="kui-nav-toggle"
        aria-haspopup="true"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        data-nav-hamburger
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </header>

    <main class="doc-main">
      <nav class="doc-switch">
        <a data-doc="catalog" href="?doc=catalog">Catalog</a>
        <a data-doc="design" href="?doc=design">Architecture</a>
      </nav>
      <article id="doc-body" class="doc-body">Loading…</article>
    </main>

    <script src="./markdown.js"></script>
    <script src="./theme.js"></script>
    <script>
      ;(async function () {
        var params = new URLSearchParams(location.search)
        var doc = params.get('doc') === 'design' ? 'design' : 'catalog'

        document.querySelectorAll('.doc-switch a').forEach(function (a) {
          if (a.dataset.doc === doc) a.setAttribute('aria-current', 'page')
        })
        document.title = 'kUInetic — ' + (doc === 'design' ? 'architecture' : 'catalog')

        var body = document.getElementById('doc-body')
        try {
          // no-store: this fetches whatever's on disk right now. Docs get edited independently of
          // any page reload the browser considers "fresh enough" to skip revalidating.
          var res = await fetch('/docs/' + doc + '.md', { cache: 'no-store' })
          if (!res.ok) throw new Error('HTTP ' + res.status)
          var text = await res.text()
          body.innerHTML = window.renderMarkdown(text)
        } catch (err) {
          body.textContent = 'Could not load docs/' + doc + '.md (' + err.message + ')'
        }
      })()
    </script>
  </body>
</html>
