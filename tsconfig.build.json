{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "types": []
  },
  "include": ["src"],
  // Tests colocated inside `src` (src/advanced/__tests__) are source, not published surface.
  // Without this they emit into dist/types and `npm pack` ships declarations for the suite.
  "exclude": ["src/**/__tests__/**"]
}
